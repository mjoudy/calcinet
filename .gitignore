# Conda environment files
envs/
.conda/
.condarc
.conda_envs/
.conda_pkgs/

# Large binary / data files
*.dat
*.npy
*.h5
*.hdf5
*.zarr
*.pkl
*.pickle
*.npz

# Experiment results: keep the big arrays OUT, but track the ledger.csv records
# (tiny text files = the scientific record of what was run + the numbers + the
# code commit). Big arrays stay out via the *.npy/*.zarr/etc rules above plus the
# blanket results/** rule here. To also version per-run configs/metrics, add:
#   !results/**/config.json
#   !results/**/metrics.json
results/**
!results/**/
!results/**/ledger.csv
scripts/sanity_n100_output/
scripts/sanity_n1250_output/

# SSH keys and credentials
key-pair
key-pair.pub
*.pem
id_rsa
id_ed25519

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Scratch / temp files
*.ods
*.ods~
*.swp
*~

scripts-hpc/dask_pipeline/logs/
scripts-hpc/dask_pipeline/data/

# Large NEST simulation logs in archive
_arxiv/scripts-hpc/dask_pipeline/*.txt

# SLURM job logs ARE tracked: they are the evidence of what was actually run
# on the cluster (small text files). Only oversized ones are excluded.
slurm_logs/**/*.zarr
slurm_logs/**/*.npy

# Python build artifacts
build/
dist/
*.egg-info/

# Figures and rendered documents: kept locally, not pushed.
# The .tex sources stay tracked; only the heavy rendered output is ignored.
*.png
*.pdf
figures/

# Quickstart example outputs (regenerate with: python examples/quickstart.py)
examples/output/
