# Conda environment files
envs/
.conda/
.condarc
.conda_envs/
.conda_pkgs/

# Large binary / data files
*.dat
*.npy
*.h5
*.hdf5
*.zarr
*.pkl
*.pickle
*.npz

# Tool output: calcinet writes runs to results/ by default. Nothing there is
# tracked -- the thesis's own ledgers and summary CSVs live in research/results/.
results/
scripts/sanity_n100_output/
scripts/sanity_n1250_output/

# SSH keys and credentials
key-pair
key-pair.pub
*.pem
id_rsa
id_ed25519

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Scratch / temp files
*.ods
*.ods~
*.swp
*~

scripts-hpc/dask_pipeline/logs/
scripts-hpc/dask_pipeline/data/

# Pre-restructure archive: kept locally, outside the repository
_arxiv/

# SLURM job logs ARE tracked: they are the evidence of what was actually run
# on the cluster (small text files). Only oversized ones are excluded.
research/slurm_logs/**/*.zarr
research/slurm_logs/**/*.npy

# Python build artifacts
build/
dist/
*.egg-info/

# Figures and rendered documents: kept locally, not pushed.
# The .tex sources stay tracked; only the heavy rendered output is ignored.
*.png
*.pdf
figures/

# Quickstart example outputs (regenerate with: python examples/quickstart.py)
examples/output/

# Theory drafts kept local-only (they were committed by mistake in f1c28996;
# they remain in history and in the v0.1.0 archive, but are not tracked from here on)
docs/theory/reproducible_framework_chapter.tex
docs/presentations/fp_analysis_summary.tex
